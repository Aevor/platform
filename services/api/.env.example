# Server
PORT=8080

# PostgreSQL
DB_HOST=localhost
DB_PORT=5433
DB_USER=aevor
DB_PASSWORD=aevor
DB_NAME=aevor
DB_SSLMODE=disable

# GitHub OAuth App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=http://localhost:8080/auth/github/callback

# JWT signing secret (HS256) - minimum 32 bytes
JWT_SECRET=

# AES-256-GCM key for encrypting GitHub access tokens at rest (32-byte hex, 64 hex chars)
# Example: 0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
GITHUB_TOKEN_ENCRYPTION_KEY=
