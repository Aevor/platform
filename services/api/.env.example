# Environment configuration for Aevor API
# Copy this file to .env and fill in the values

# Server
PORT=8080

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=aevor
DB_PASSWORD=your_secure_password_here
DB_NAME=aevor
DB_SSLMODE=disable

# GitHub OAuth 2.0 (required)
# Create a GitHub OAuth App at https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URL=http://localhost:8080/auth/github/callback

# GitHub Webhook Secret (required for webhook verification)
# Generate with: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# Frontend URL (required for OAuth redirect)
FRONTEND_URL=http://localhost:5173

# Optional: GitHub Enterprise API base URL
# GITHUB_API_BASE_URL=https://github.yourcompany.com/api/v3

# JWT Secret (required, minimum 32 bytes)
# Generate with: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_at_least_32_bytes_long

# GitHub Token Encryption Key (required, exactly 32 bytes as hex = 64 hex chars)
# Generate with: openssl rand -hex 32
GITHUB_TOKEN_ENCRYPTION_KEY=your_32_byte_hex_encryption_key_64_chars

# Workspace Root (required, controlled directory for repository workspaces)
WORKSPACE_ROOT=/workspace

# Clone Policy
# Comma-separated list of allowed hosts for git clone (default: github.com)
CLONE_ALLOWED_HOSTS=github.com
# Allow file:// clone URLs for local development (default: false)
CLONE_ALLOW_FILE_URLS=false

# Filtering Limits
# Per-file inclusion limit in bytes (default: 1MiB)
FILTER_MAX_FILE_SIZE=1048576
# Total size limit for selected content in bytes (default: 32MiB)
FILTER_MAX_TOTAL_BYTES=33554432
# Maximum files per filtering result (default: 5000)
FILTER_MAX_FILES=5000

# AI Service
AI_SERVICE_URL=http://localhost:8000/api
AI_SERVICE_API_KEY=your_ai_service_api_key

# Job Worker Configuration
JOBS_CONCURRENCY=4
JOBS_POLL_INTERVAL=2
JOBS_HEARTBEAT_INTERVAL=15
JOBS_LEASE_SECONDS=120
JOBS_STALE_SECONDS=300
JOBS_BACKOFF_BASE_SECONDS=5
JOBS_BACKOFF_MAX_SECONDS=300

# Concurrency Limits (0 = no limit)
JOB_GLOBAL_CONCURRENCY_LIMIT=0
JOB_PER_USER_CONCURRENCY_LIMIT=0
JOB_PER_REPO_CONCURRENCY_LIMIT=0

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPM=60
RATE_LIMIT_RPH=1000
RATE_LIMIT_BURST=10

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ALLOW_CREDENTIALS=false

# Resource Limits
MAX_REQUEST_BODY_BYTES=10485760
MAX_WEBHOOK_PAYLOAD_BYTES=1048576
MAX_AI_CONTEXT_CHUNKS=128
MAX_AI_CONTEXT_TOTAL_BYTES=262144
MAX_VALIDATION_OUTPUT_BYTES=8192
MAX_JOB_PAYLOAD_BYTES=1048576
MAX_GIT_OPS_PER_MIN=30

# AI Rate Limiting
AI_RATE_LIMIT_ENABLED=true
AI_RATE_LIMIT_PER_USER=10
AI_RATE_LIMIT_PER_REPO=30
AI_RATE_LIMIT_GLOBAL=100

# Database
DB_QUERY_TIMEOUT_SECONDS=30
MAX_PAGE_SIZE=100