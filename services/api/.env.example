# Server
PORT=8080

# PostgreSQL
DB_HOST=localhost
DB_PORT=5433
DB_USER=aevor
DB_PASSWORD=aevor
DB_NAME=aevor
DB_SSLMODE=disable

# GitHub OAuth App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=http://localhost:8080/auth/github/callback

# Aevor frontend base URL - after a successful OAuth callback the API
# redirects the browser here with ?token=<JWT> so the SPA can capture it.
# REQUIRED.
FRONTEND_URL=http://localhost:5173

# JWT signing secret (HS256) - minimum 32 bytes
JWT_SECRET=

# AES-256-GCM key for encrypting GitHub access tokens at rest (32-byte hex, 64 hex chars)
# Example: 0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
GITHUB_TOKEN_ENCRYPTION_KEY=

# OPTIONAL: override the GitHub REST API base URL (integration testing only).
# Leave empty in production.
GITHUB_API_BASE_URL=

# REQUIRED: controlled filesystem root for cloned repository workspaces.
# The API validates this at startup and never writes workspaces outside it.
WORKSPACE_ROOT=

# OPTIONAL: comma-separated https host allowlist for Git clones (default: github.com).
CLONE_ALLOWED_HOSTS=github.com

# OPTIONAL: allow file:// clone URLs. LOCAL DEVELOPMENT / INTEGRATION ONLY.
# Never enable in production. Default: false (empty means false).
CLONE_ALLOW_FILE_URLS=

# OPTIONAL: codebase filtering limits (Task 3c). Empty = built-in defaults.
# Per-file inclusion limit in bytes (default 1048576 = 1 MiB).
FILTER_MAX_FILE_SIZE=
# Total selected-content budget in bytes (default 33554432 = 32 MiB).
FILTER_MAX_TOTAL_BYTES=
# Maximum number of included files per filtering result (default 5000).
FILTER_MAX_FILES=
