# Aevor API — environment template
#
# Copy to `services/api/.env` and fill in the REQUIRED values:
#
#     cp services/api/.env.example services/api/.env
#
# Then verify the environment before starting the server:
#
#     go run ./cmd/doctor
#
# `doctor` checks every value below, reports what it observed, and prints NO
# secret material. Exit codes: 0 ready, 1 degraded, 2 not ready.
#
# Rules that apply to this whole file:
#   * One KEY=value per line. Two keys on one line are silently merged, which
#     produces baffling values like WORKSPACE_ROOT=/srv/aevorFRONTEND_URL=...
#   * No trailing spaces, no quotes unless the value needs them.
#   * NEVER commit a filled-in .env. Only this template is tracked.

# ===========================================================================
# REQUIRED — the process refuses to start without these
# ===========================================================================

# HTTP listen port for the API.
PORT=8080

# --- Database (PostgreSQL) -------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=aevor
DB_PASSWORD=change-me
DB_NAME=aevor
# disable for local docker-compose; require for any managed/remote database.
DB_SSLMODE=disable
DB_QUERY_TIMEOUT_SECONDS=30

# --- Secrets ---------------------------------------------------------------
# JWT_SECRET signs Aevor session tokens. Generate with:
#   openssl rand -hex 32
# Must be at least 32 bytes. It must NOT equal GITHUB_TOKEN_ENCRYPTION_KEY:
# signing and encryption are different trust boundaries.
JWT_SECRET=

# GITHUB_TOKEN_ENCRYPTION_KEY encrypts stored GitHub access tokens at rest
# (AES-256-GCM). Exactly 32 bytes, i.e. 64 hex characters. Generate with:
#   openssl rand -hex 32
# Rotating it makes every previously stored token undecryptable; see SECURITY.md.
GITHUB_TOKEN_ENCRYPTION_KEY=

# --- Workspace -------------------------------------------------------------
# The ONLY directory Aevor will clone repositories into. It must exist and be
# writable by the process user. Aevor never writes a workspace anywhere else.
WORKSPACE_ROOT=./workspaces

# --- GitHub OAuth App ------------------------------------------------------
# From https://github.com/settings/developers -> OAuth Apps.
# Authorization callback URL must match GITHUB_REDIRECT_URL exactly.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=http://localhost:8080/auth/github/callback

# Override only for GitHub Enterprise. Leave blank for github.com.
GITHUB_API_BASE_URL=

# Secret configured on the GitHub webhook. Unset means /webhooks/github rejects
# every delivery (it never accepts an unverified one).
GITHUB_WEBHOOK_SECRET=

# ===========================================================================
# Strongly recommended
# ===========================================================================

# --- Frontend / CORS -------------------------------------------------------
# The browser application that completes the OAuth redirect. The callback
# redirects to FRONTEND_URL + /auth/callback?token=... — this is
# configuration, never request input, so it cannot become an open redirect.
FRONTEND_URL=http://localhost:5173

# Comma-separated exact origins allowed to call the API. "*" allows any origin.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ALLOW_CREDENTIALS=false

# Secure attribute on the OAuth state/PKCE cookie. Set true for ANY https
# deployment. It is false here only so plain-http localhost login works.
OAUTH_COOKIE_SECURE=false

# --- Clone policy ----------------------------------------------------------
# https hosts the server may clone from.
CLONE_ALLOWED_HOSTS=github.com
# Allow local file:// clones (tests and the local demo). Never enable in
# production: it lets a caller make the server read arbitrary local paths.
CLONE_ALLOW_FILE_URLS=false

# --- AI service (optional) -------------------------------------------------
# Unreachable or unset AI degrades AI features to deterministic fallbacks; the
# rest of the API keeps working. `doctor` reports it as a warning, not an error.
AI_SERVICE_URL=http://localhost:11434
AI_SERVICE_API_KEY=

# ===========================================================================
# Optional — resource limits (defaults shown; omit to use the default)
# ===========================================================================

# --- Request / payload sizes (bytes) --------------------------------------
MAX_REQUEST_BODY_BYTES=10485760
MAX_WEBHOOK_PAYLOAD_BYTES=1048576
MAX_JOB_PAYLOAD_BYTES=1048576

# --- AI context bounds -----------------------------------------------------
MAX_AI_CONTEXT_CHUNKS=128
MAX_AI_CONTEXT_TOTAL_BYTES=262144

# --- Workspace / validation ------------------------------------------------
# Maximum captured bytes per controlled validation check.
MAX_VALIDATION_OUTPUT_BYTES=8192
# Git operations per minute, per user.
MAX_GIT_OPS_PER_MIN=30

# --- File selection budgets ------------------------------------------------
FILTER_MAX_FILE_SIZE=1048576
FILTER_MAX_TOTAL_BYTES=52428800
FILTER_MAX_FILES=500

# --- Pagination ------------------------------------------------------------
MAX_PAGE_SIZE=100

# ===========================================================================
# Optional — background jobs
# ===========================================================================
JOBS_CONCURRENCY=4
JOBS_POLL_INTERVAL=2
JOBS_HEARTBEAT_INTERVAL=15
JOBS_LEASE_SECONDS=120
JOBS_STALE_SECONDS=300
JOBS_BACKOFF_BASE_SECONDS=5
JOBS_BACKOFF_MAX_SECONDS=300
# 0 disables the individual cap.
JOB_GLOBAL_CONCURRENCY_LIMIT=0
JOB_PER_USER_CONCURRENCY_LIMIT=2
JOB_PER_REPO_CONCURRENCY_LIMIT=2

# ===========================================================================
# Optional — rate limiting
# ===========================================================================
# Public routes (login, callback, webhooks) are limited per client IP.
# Authenticated routes are limited per verified user.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPM=60
RATE_LIMIT_RPH=1000
RATE_LIMIT_BURST=10

AI_RATE_LIMIT_ENABLED=true
AI_RATE_LIMIT_PER_USER=10
AI_RATE_LIMIT_PER_REPO=30
AI_RATE_LIMIT_GLOBAL=100
